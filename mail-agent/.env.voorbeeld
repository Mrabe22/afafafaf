# Kopieer dit bestand naar .env (in dezelfde map) en vul het in. .env komt NOOIT in git.

# --- Mailbox (Mijndomein) ---
MAIL_ADRES=info@rabetrading.com
MAIL_WACHTWOORD=
IMAP_HOST=mail.mijndomein.nl
IMAP_POORT=993
AFZENDER_NAAM=Rabe Trading
# Andere adressen die van jou zijn (komma-gescheiden), zodat je eigen mails nooit beantwoord worden
EIGEN_ADRESSEN=

# --- Claude (API-sleutel van console.anthropic.com, los van je Claude-abonnement) ---
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
# Model voor sorteren en de 4 controles. claude-sonnet-5-5 is ongeveer de helft goedkoper.
MODEL_CONTROLES=claude-opus-5-5

# --- Shopify (dezelfde app-gegevens als de tracking-sync) ---
SHOPIFY_SHOP=tr1d9f-jk.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Gedrag ---
# droog = niets in de mailbox aanraken, concepten naar de map uit\   |   concept = concepten in je mailbox
MODUS=droog
# Mails van voor deze datum worden NOOIT aangeraakt (verplicht in concept-modus)
STARTDATUM=
MAX_PER_RUN=10
MAX_HERSCHRIJFRONDES=2
# Categorieen die een concept krijgen
CATEGORIEEN=klantvraag,bestelling,offerte,retour_klacht

# Namen van leveranciers die nooit in een klantmail mogen (komma-gescheiden)
LEVERANCIERS=
# Maildomeinen van leveranciers (alleen voor de export: die mails tellen niet als klantvoorbeeld)
LEVERANCIERS_DOMEINEN=
